<!DOCTYPE html>
<html lang="en" class="min-h-full bg-[#0e0e10] scheme-dark">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || ApplicationHelper::SITE_TITLE %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= ApplicationHelper::SITE_DESCRIPTION %>">
    <meta name="robots" content="index,follow,max-image-preview:large">
    <meta name="theme-color" content="#0e0e10">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Metronome">
    <meta name="mobile-web-app-capable" content="yes">
    <link rel="canonical" href="<%= canonical_url %>">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Metronome">
    <meta property="og:locale" content="en_US">
    <meta property="og:title" content="<%= content_for(:title) || ApplicationHelper::SITE_TITLE %>">
    <meta property="og:description" content="<%= ApplicationHelper::SITE_DESCRIPTION %>">
    <meta property="og:url" content="<%= canonical_url %>">
    <meta property="og:image" content="<%= social_image_url %>">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Metronome – a free online tempo and practice tool">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for(:title) || ApplicationHelper::SITE_TITLE %>">
    <meta name="twitter:description" content="<%= ApplicationHelper::SITE_DESCRIPTION %>">
    <meta name="twitter:image" content="<%= social_image_url %>">
    <meta name="twitter:image:alt" content="Metronome – a free online tempo and practice tool">

    <% if ENV["GOOGLE_SITE_VERIFICATION"].present? %>
      <meta name="google-site-verification" content="<%= ENV["GOOGLE_SITE_VERIFICATION"] %>">
    <% end %>
    <% if ENV["BING_SITE_VERIFICATION"].present? %>
      <meta name="msvalidate.01" content="<%= ENV["BING_SITE_VERIFICATION"] %>">
    <% end %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192">
    <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180">

    <script type="application/ld+json"><%= raw json_escape(web_application_structured_data) %></script>

    <%# Propshaft includes the compiled Tailwind build from app/assets/builds. %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen min-w-80 [background:radial-gradient(circle_at_15%_10%,rgba(111,77,255,0.17),transparent_32rem),radial-gradient(circle_at_90%_90%,rgba(233,255,112,0.09),transparent_28rem),#0e0e10] font-sans text-[#f7f4ed]">
    <%= yield %>
  </body>
</html>
